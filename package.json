{
  "name": "dsh-skill-manager",
  "version": "0.3.0",
  "description": "Smart classification and usage suggestions for a DeepSeek Harness skill library: find and manage the right skill once you have many.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/DeepSeek-Harness-Skill-Manager.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node client/build.mjs",
    "test": "node test/host.test.mjs && node test/plugin.test.mjs && node test/client.test.mjs && node test/ui.test.mjs",
    "test:node": "node --test test/",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "skills",
    "skill"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-skill": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
