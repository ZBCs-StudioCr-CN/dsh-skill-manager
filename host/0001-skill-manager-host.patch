+/** Authoring payload for a SKILL.md the provider persists into its own writable root. */
+export interface SkillWriteInput {
+  /** Kebab-case skill name; becomes the skill directory name. */
+  readonly name: string
+  /** Short routing description (required frontmatter). */
+  readonly description: string
+  /** Optional extra routing guidance. */
+  readonly whenToUse?: string
+  /** False writes `disable-model-invocation: true`. */
+  readonly modelInvocable: boolean
+  /** False writes `user-invocable: false`. */
+  readonly userInvocable: boolean
+  /** Markdown instruction body written below the frontmatter (not the rendered `<skill_content>` wrapper). */
+  readonly body: string
+}
+
+/** Acknowledgement of a persisted SKILL.md. */
+export interface SkillWriteResult {
+  /** The kebab-case skill name just written. */
+  readonly name: string
+  /** Absolute SKILL.md path on the host. */
+  readonly path: string
+}
+
+/**
+ * Optional provider capability that persists SKILL.md files into a writable
+ * root. Only providers that own local writable files implement this; the
+ * read-only registry contract is untouched for every other provider.
+ */
+export interface SkillProviderMutate {
+  /** Create a new skill. */
+  readonly create: (input: SkillWriteInput) => Promise<SkillWriteResult>
+  /** Return a skill's current editable content from this provider's writable root. */
+  readonly read: (name: string) => Promise<SkillWriteInput | undefined>
