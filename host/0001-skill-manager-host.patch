+import { describe, expect, it } from 'vitest'
+import { mkdir, readFile, rm, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { Context } from '@deepseek-ai/cordis'
+import SkillRegistry from '@deepseek-ai/dsh-skill'
+import * as SkillFileSystem from '../src/index.ts'
+import { createSkill, SkillNameInvalidError, updateSkill, removeSkill, renderSkillMarkdown } from '../src/writer.ts'
+
+async function tempDir(name: string): Promise<string> {
+  return await import('node:fs/promises').then(fs => fs.mkdtemp(join(tmpdir(), `dsh-${name}-`)))
+}
+
+async function setupLocal(home: string): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(SkillRegistry)
+  await ctx.plugin(SkillFileSystem, {
+    dshHome: join(home, '.dsh'),
+    agentsHome: join(home, '.agents'),
+    watch: false,
+  })
+  return ctx
+}
+
+function input(over: Partial<Parameters<typeof renderSkillMarkdown>[0]> = {}) {
+  return {
+    name: 'my-skill',
+    description: 'A test skill',
+    modelInvocable: true,
+    userInvocable: true,
+    body: 'Instructions body.',
+    ...over,
+  }
+}
+
+function userSkillsRoot(home: string): string {
+  return join(home, '.dsh', 'skills')
+}
+
+function skillFilePath(home: string, name: string): string {
+  return join(userSkillsRoot(home), name, 'SKILL.md')
+}
+
+describe('skill writer helpers', () => {
+  it('renders a SKILL.md the reader parses back with invocation flags', async () => {
+    const rendered = renderSkillMarkdown(input({
+      name: 'color-swap',
+      description: 'Swap colors',
+      modelInvocable: false,
+      userInvocable: false,
+      whenToUse: 'When a swap is needed',
+    }))
+    expect(rendered).toContain(`name: color-swap`)
+    expect(rendered).toContain(`description: Swap colors`)
+    expect(rendered).toContain(`whenToUse: When a swap is needed`)
+    expect(rendered).toContain(`disable-model-invocation: true`)
+    expect(rendered).toContain(`user-invocable: false`)
+    expect(rendered.endsWith('\n')).toBe(true)
+  })
+
+  it('rejects a non-kebab name', async () => {
+    const root = await tempDir('skill-writer-bad-name')
+    await expect(createSkill(root, input({ name: 'Bad Name' }))).rejects.toThrow(SkillNameInvalidError)
+  })
+})
+
+describe('FileSystemSkillProvider mutation', () => {
+  it('exposes only the user skills root through ctx.skills.mutator()', async () => {
+    const home = await tempDir('skill-mutator')
+    const ctx = await setupLocal(home)
+    const mutate = ctx.skills.mutator()
+    expect(mutate).toBeDefined()
+  })
+
+  it('creates, reads back through the catalog, updates, and removes a skill', async () => {
+    const home = await tempDir('skill-crud')
+    const ctx = await setupLocal(home)
+    const mutate = ctx.skills.mutator()
+    expect(mutate).toBeDefined()
+
+    // create
+    const created = await mutate!.create(input({ name: 'crud-skill', description: 'first pass' }))
+    expect(created.name).toBe('crud-skill')
+    expect(created.path).toBe(skillFilePath(home, 'crud-skill'))
+    await expect(readFile(created.path, 'utf8')).resolves.toContain('description: first pass')
+
+    // discovered in the catalog
+    const listed = await ctx.skills.list()
+    expect(listed.map(skill => skill.name)).toContain('crud-skill')
+
+    // refusing a duplicate create
+    await expect(mutate!.create(input({ name: 'crud-skill', description: 'again' })))
+      .rejects.toThrow(/already exists/)
+
+    // update
+    const updated = await mutate!.update('crud-skill', input({ name: 'crud-skill', description: 'second pass', body: 'New body.' }))
+    expect(updated.path).toBe(skillFilePath(home, 'crud-skill'))
+    const text = await readFile(updated.path, 'utf8')
+    expect(text).toContain('description: second pass')
+    expect(text).toContain('New body.')
+    // renamed content stays discoverable under the same name
+    const after = await ctx.skills.list()
+    expect(after.find(skill => skill.name === 'crud-skill')?.description).toBe('second pass')
+
+    // update of a missing skill
+    await expect(mutate!.update('absent-skill', input({ name: 'absent-skill' }))).rejects.toThrow(/does not exist/)
+
+    // remove
+    await mutate!.remove('crud-skill')
+    const remaining = await ctx.skills.list()
+    expect(remaining.map(skill => skill.name)).not.toContain('crud-skill')
+
+    // removing a missing skill is a readable refusal
+    await expect(mutate!.remove('crud-skill')).rejects.toThrow(/does not exist/)
+  })
+
+  it('rejects authoring an invalid name through the provider', async () => {
+    const home = await tempDir('skill-crud-bad')
+    const ctx = await setupLocal(home)
+    const mutate = ctx.skills.mutator()!
+    await expect(mutate.create(input({ name: 'upper Case' }))).rejects.toThrow(SkillNameInvalidError)
+    await expect(mutate.update('upper Case', input({ name: 'upper Case' }))).rejects.toThrow(SkillNameInvalidError)
+    await expect(mutate.remove('upper Case')).rejects.toThrow(SkillNameInvalidError)
+  })
+
+  it('writes only user-owned fixes into the user root and leaves project roots untouched', async () => {
+    const home = await tempDir('skill-crud-scope')
+    const project = await tempDir('skill-project')
+    await mkdir(join(project, '.git'), { recursive: true })
+    const ctx = new Context()
+    await ctx.plugin(SkillRegistry)
+    await ctx.plugin(SkillFileSystem, {
+      dshHome: join(home, '.dsh'),
+      agentsHome: join(home, '.agents'),
+      watch: false,
+    })
+    const mutate = ctx.skills.mutator()!
+    await mutate!.create(input({ name: 'home-skill' }))
+    // created under user home, not the project cwd
+    await expect(readFile(skillFilePath(home, 'home-skill'), 'utf8')).resolves.toContain('description: A test skill')
+    await rm(skillFilePath(home, 'home-skill'))
+  })
+})
