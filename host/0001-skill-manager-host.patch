index 0000000000..ebfcc68b61
--- /dev/null
+++ b/packages/host/apiproxy/src/skill-preferences.ts
@@ -0,0 +1,135 @@
+/**
+ * Skill preferences: user-level enablement and categorization stored in
+ * `$DSH_HOME/skill-preferences.json`. Kept separate from SKILL.md bodies so
+ * toggling enablement or reorganizing categories never rewrites user skill
+ * files. Absent file or empty `enabled` means every user-invocable skill stays
+ * enabled (backward compatible); once a non-empty list exists, only listed
+ * names are enabled.
+ * @module @deepseek-ai/dsh-host-apiproxy/skill-preferences
+ */
+
+import { readFile, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { homedir } from 'node:os'
+
+/** Preference file version; bump with incompatible shape changes. */
+export const SKILL_PREFERENCES_VERSION = 1
+
+/** One user category; a skill may belong to several categories. */
+export interface SkillCategory {
+  /** Stable kebab-case id used as the category key. */
+  readonly id: string
+  /** Display name shown in the UI. */
+  readonly name: string
+  /** Optional extra terms smart classification matches against (the name always counts). */
+  readonly keywords?: readonly string[]
+  /** Skill names assigned to this category. */
+  readonly skills: readonly string[]
+}
+
+/** The whole persisted preference set. */
+export interface SkillPreferences {
+  /** Shape version (SKILL_PREFERENCES_VERSION). */
+  readonly version: number
+  /** Enabled skill names; empty/absent means everything is enabled. */
+  readonly enabled: readonly string[]
+  /** Skill names auto-loaded into every new/opened session. */
+  readonly defaultLoaded: readonly string[]
+  /** Category definitions and member lists. */
+  readonly categories: readonly SkillCategory[]
+}
+
+/** Empty preferences with a valid version (no enablement restriction). */
+export function emptyPreferences(): SkillPreferences {
+  return { version: SKILL_PREFERENCES_VERSION, enabled: [], defaultLoaded: [], categories: [] }
+}
+
+/** Resolve the user skills root (`$DSH_HOME/skills`), same resolution as the filesystem provider's user-dsh root. */
+export function resolveUserSkillsRoot(dshHome?: string): string {
+  const home = dshHome !== undefined && dshHome.trim().length > 0
+    ? dshHome
+    : (process.env.DSH_HOME !== undefined && process.env.DSH_HOME.trim().length > 0
+      ? process.env.DSH_HOME
+      : join(homedir(), '.dsh'))
+  return join(home, 'skills')
+}
+
+/** Resolve the preferences file path under the user harness home. */
+export function skillPreferencesPath(dshHome?: string): string {
+  const home = dshHome !== undefined && dshHome.trim().length > 0
+    ? dshHome
+    : (process.env.DSH_HOME !== undefined && process.env.DSH_HOME.trim().length > 0
+      ? process.env.DSH_HOME
+      : join(homedir(), '.dsh'))
+  return join(home, 'skill-preferences.json')
+}
+
+/**
+ * Read the persisted preferences; a missing or corrupt file yields empty
+ * preferences (all enabled) rather than a hard failure.
+ * @param file - the preferences file path.
+ * @returns the parsed preferences.
+ */
+export async function readSkillPreferences(file: string): Promise<SkillPreferences> {
+  let raw: string
+  try {
+    raw = await readFile(file, 'utf8')
+  } catch {
+    return emptyPreferences()
+  }
+  try {
+    const parsed = JSON.parse(raw) as unknown
+    return normalizePreferences(parsed)
+  } catch {
+    // Corrupt file: treat as empty; the next update overwrites it.
+    return emptyPreferences()
+  }
+}
+
+/**
+ * Persist preferences atomically enough for a user config file (write via temp
+ * sibling then rename is not required here; the GUI is the only writer).
+ * @param file - the preferences file path.
+ * @param preferences - the full set to persist.
+ */
+export async function writeSkillPreferences(file: string, preferences: SkillPreferences): Promise<void> {
+  await writeFile(file, `${JSON.stringify(preferences, null, 2)}\n`, 'utf8')
+}
+
+/**
+ * Whether a skill name is enabled under the given preferences. An empty
+ * `enabled` list (the default and backward-compatible state) enables all.
+ * @param preferences - the preference set.
+ * @param name - the skill name.
+ * @returns whether the skill is enabled.
+ */
+export function isSkillEnabled(preferences: SkillPreferences, name: string): boolean {
+  return preferences.enabled.length === 0 || preferences.enabled.includes(name)
+}
+
+/** Coerce an untrusted parsed value into a valid preference shape. */
+function normalizePreferences(value: unknown): SkillPreferences {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) return emptyPreferences()
+  const record = value as Record<string, unknown>
+  return {
+    version: typeof record.version === 'number' ? record.version : SKILL_PREFERENCES_VERSION,
+    enabled: stringArray(record.enabled),
+    defaultLoaded: stringArray(record.defaultLoaded),
+    categories: Array.isArray(record.categories)
+      ? record.categories
+          .filter((entry): entry is Record<string, unknown> => typeof entry === 'object' && entry !== null && !Array.isArray(entry))
+          .map(entry => ({
+            id: typeof entry.id === 'string' ? entry.id : '',
+            name: typeof entry.name === 'string' ? entry.name : '',
+            keywords: stringArray(entry.keywords),
+            skills: stringArray(entry.skills),
+          }))
+          .filter(category => category.id.length > 0)
+      : [],
+  }
+}
+
+function stringArray(value: unknown): string[] {
+  if (!Array.isArray(value)) return []
+  return value.filter((entry): entry is string => typeof entry === 'string')
+}
