diff --git a/packages/skill/skill-filesystem/src/writer.ts b/packages/skill/skill-filesystem/src/writer.ts
new file mode 100644
index 0000000000..beb6c9fce7
--- /dev/null
+++ b/packages/skill/skill-filesystem/src/writer.ts
@@ -0,0 +1,243 @@
+/**
+ * SKILL.md authoring for the local filesystem skill provider.
+ *
+ * Authoring is confined to the provider's user-owned `$DSH_HOME/skills` root —
+ * the same `user-dsh` root discovery already scans. Project and bundled roots
+ * are not writable targets: they belong to repositories or the deployment, and
+ * rewriting them from the GUI would surprise the project owner or an upgrade.
+ *
+ * The write target is deliberately derived from a validated skill name (the
+ * skill directory name), never from a caller-supplied path, so a malformed
+ * name cannot escape the skills root — the agent-presets authoring stance.
+ *
+ * @module @deepseek-ai/dsh-skill-filesystem/writer
+ */
+
+import { rm, readFile, stat } from 'node:fs/promises'
+import { join, resolve } from 'node:path'
+import { writeFileAtomic } from '@deepseek-ai/dsh-atomic-write'
+import { parse as parseYaml, stringify as stringifyYaml } from 'yaml'
+import { isSkillName, type SkillWriteInput, type SkillWriteResult } from '@deepseek-ai/dsh-skill'
+
+/** SKILL.md filename inside each skill directory. */
+export const SKILL_FILE = 'SKILL.md'
+
+/** Stable wire-visible authoring error code carried by writer rejections. */
+export type SkillAuthoringErrorCode =
+  | 'skill-invalid-name'
+  | 'skill-exists'
+  | 'skill-not-found'
+  | 'skill-not-writable'
+
+/** Base for authoring rejections so the host maps them to wire codes without importing this package. */
+class SkillAuthoringError extends Error {
+  constructor(
+    readonly code: SkillAuthoringErrorCode,
+    message: string,
+  ) {
+    super(message)
+    this.name = 'SkillAuthoringError'
+  }
+}
+
+/** A skill name that cannot be used as a directory under the skills root. */
+export class SkillNameInvalidError extends SkillAuthoringError {
+  constructor(
+    /** The rejected name. */
+    readonly skillName: string,
+  ) {
+    super(
+      'skill-invalid-name',
+      `skill-filesystem: skill name ${JSON.stringify(skillName)} must match `
+      + 'the kebab-case name grammar — the name is a directory name, so anything else could escape the skills root',
+    )
+  }
+}
+
+/** Authoring targeted a name that already occupies a directory. */
+export class SkillExistsError extends SkillAuthoringError {
+  constructor(
+    /** The name that is already taken. */
+    readonly skillName: string,
+  ) {
+    super('skill-exists', `skill-filesystem: skill '${skillName}' already exists — create never overwrites; delete it first or choose another name`)
+  }
+}
+
+/** A relative skill record reference requested no existing skill. */
+export class SkillNotFoundError extends SkillAuthoringError {
+  constructor(
+    /** The name that is absent. */
+    readonly skillName: string,
+  ) {
+    super('skill-not-found', `skill-filesystem: skill '${skillName}' does not exist in the user skills root`)
+  }
+}
+
+/** Attempted authoring where this deployment exposes no writable skills root. */
+export class SkillNotWritableError extends SkillAuthoringError {
+  constructor() {
+    super('skill-not-writable', 'skill-filesystem: authoring requires a user-dsh skills root under $DSH_HOME')
+  }
+}
+
+/**
+ * Serialize one skill into the frontmatter + body SKILL.md text the reader parses back.
+ * @param input - the skill content to persist.
+ * @returns the full SKILL.md document text.
+ */
+export function renderSkillMarkdown(input: SkillWriteInput): string {
+  const code = {
+    name: input.name,
+    description: input.description,
+    ...input.whenToUse !== undefined && input.whenToUse.length > 0 ? { whenToUse: input.whenToUse } : {},
+    ...input.modelInvocable ? {} : { 'disable-model-invocation': true },
+    ...input.userInvocable ? {} : { 'user-invocable': false },
+  }
+  const frontmatter = stringifyYaml(code).trimEnd()
+  const body = input.body.trim()
+  return `---\n${frontmatter}\n---\n\n${body}\n`
+}
+
+/**
+ * Read a user-owned skill's full editable content from the skills root.
+ * @param skillsRoot - the user-dsh skills root.
+ * @param name - the existing skill to read.
+ * @returns the parsed editable content, or `undefined` when the skill is absent.
+ */
+export async function readSkill(skillsRoot: string, name: string): Promise<SkillWriteInput | undefined> {
+  if (!isSkillName(name)) return undefined
+  const path = join(skillsRoot, name, SKILL_FILE)
+  let text: string
+  try {
+    text = await readFile(path, 'utf8')
+  } catch {
+    // Missing files are authoritative absence, matching discovery.
+    return undefined
+  }
+  const parsed = parseSkillMarkdown(text)
+  return parsed === undefined ? undefined : { name, ...parsed }
+}
+
+function parseSkillMarkdown(text: string): Omit<SkillWriteInput, 'name'> | undefined {
+  const headerEnd = text.indexOf('\n')
+  const header = text.slice(0, headerEnd < 0 ? undefined : headerEnd).replace(/\r$/, '')
+  if (header !== '---') return undefined
+  const start = headerEnd + 1
+  const closing = findClosingFrontmatter(text, start)
+  if (closing === undefined) return undefined
+  const yaml = text.slice(start, closing.start)
+  let data: unknown
+  try {
+    data = parseYaml(yaml)
+  } catch {
+    return undefined
+  }
+  if (typeof data !== 'object' || data === null || Array.isArray(data)) return undefined
+  const record = data as Record<string, unknown>
+  const description = stringValue(record.description)
+  if (description === undefined) return undefined
+  return {
+    description,
+    ...optionalStringValue(record.whenToUse),
+    modelInvocable: !booleanValue(record['disable-model-invocation'], false),
+    userInvocable: booleanValue(record['user-invocable'], true),
+    body: text.slice(closing.bodyStart).trim(),
+  }
+}
+
+function stringValue(value: unknown): string | undefined {
+  return typeof value === 'string' && value.length > 0 ? value : undefined
+}
+
+function optionalStringValue(value: unknown): { whenToUse: string } | Record<string, never> {
+  const text = stringValue(value)
+  return text === undefined ? {} : { whenToUse: text }
+}
+
+function booleanValue(value: unknown, fallback: boolean): boolean {
+  if (typeof value === 'boolean') return value
+  return fallback
+}
+
+function findClosingFrontmatter(raw: string, start: number): { start: number; bodyStart: number } | undefined {
+  let lineStart = start
+  while (lineStart <= raw.length) {
+    const nextNewline = raw.indexOf('\n', lineStart)
+    const lineEnd = nextNewline < 0 ? raw.length : nextNewline
+    const line = raw.slice(lineStart, lineEnd).replace(/\r$/, '')
+    if (line === '---') {
+      return { start: lineStart, bodyStart: nextNewline < 0 ? raw.length : nextNewline + 1 }
+    }
+    if (nextNewline < 0) return undefined
+    lineStart = nextNewline + 1
+  }
+  return undefined
+}
+
+/**
+ * Whether a directory already exists under the skills root for this name.
+ * The reader treats a present directory as occupying the name, so authoring
+ * holds the same guard before it writes.
+ */
+async function occupied(skillsRoot: string, name: string): Promise<boolean> {
+  try {
+    await stat(join(skillsRoot, name))
+    return true
+  } catch {
+    // Any stat failure means nothing usable occupies the path; the write may claim it.
+    return false
+  }
+}
+
+/**
+ * Create a new skill directory under the user skills root.
+ * @param skillsRoot - the user-dsh skills root.
+ * @param input - the skill to persist.
+ * @returns the absolute SKILL.md path.
+ */
+export async function createSkill(skillsRoot: string, input: SkillWriteInput): Promise<SkillWriteResult> {
+  const dir = writableDirectory(skillsRoot, input.name)
+  if (await occupied(skillsRoot, input.name)) throw new SkillExistsError(input.name)
+  const path = join(dir, SKILL_FILE)
+  await writeFileAtomic(path, renderSkillMarkdown(input), { mode: 0o600, dirMode: 0o700 })
+  return { name: input.name, path }
+}
+
+/**
+ * Overwrite an existing skill's SKILL.md under the user skills root.
+ * @param skillsRoot - the user-dsh skills root.
+ * @param name - the existing skill to replace.
+ * @param input - the skill content to persist.
+ * @returns the absolute SKILL.md path.
+ */
+export async function updateSkill(skillsRoot: string, name: string, input: SkillWriteInput): Promise<SkillWriteResult> {
+  const dir = writableDirectory(skillsRoot, name)
+  if (!(await occupied(skillsRoot, name))) throw new SkillNotFoundError(name)
+  const path = join(dir, SKILL_FILE)
+  await writeFileAtomic(path, renderSkillMarkdown(input), { mode: 0o600, dirMode: 0o700 })
+  return { name, path }
+}
+
+/**
+ * Delete a skill directory under the user skills root.
+ * @param skillsRoot - the user-dsh skills root.
+ * @param name - the existing skill to remove.
+ */
+export async function removeSkill(skillsRoot: string, name: string): Promise<void> {
+  if (!isSkillName(name)) throw new SkillNameInvalidError(name)
+  const dir = writableDirectory(skillsRoot, name)
+  if (!(await occupied(skillsRoot, name))) throw new SkillNotFoundError(name)
+  await rmRecursive(dir)
+}
+
+function writableDirectory(skillsRoot: string, name: string): string {
+  if (skillsRoot.length === 0) throw new SkillNotWritableError()
+  if (!isSkillName(name)) throw new SkillNameInvalidError(name)
+  // Derive the target from the validated name; containment is structural.
+  return resolve(join(skillsRoot, name))
+}
+
+function rmRecursive(dir: string): Promise<void> {
+  return rm(dir, { recursive: true, force: true })
+}
