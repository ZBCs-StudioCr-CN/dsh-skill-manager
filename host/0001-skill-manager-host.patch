+import { describe, expect, it } from 'vitest'
+import { mkdir, readFile, rm, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { Context } from '@deepseek-ai/cordis'
+import SkillRegistry from '@deepseek-ai/dsh-skill'
+import * as SkillFileSystem from '../src/index.ts'
+import { createSkill, SkillNameInvalidError, updateSkill, removeSkill, renderSkillMarkdown } from '../src/writer.ts'
+
+async function tempDir(name: string): Promise<string> {
+  return await import('node:fs/promises').then(fs => fs.mkdtemp(join(tmpdir(), `dsh-${name}-`)))
+}
+
+async function setupLocal(home: string): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(SkillRegistry)
+  await ctx.plugin(SkillFileSystem, {
+    dshHome: join(home, '.dsh'),
+    agentsHome: join(home, '.agents'),
+    watch: false,
+  })
+  return ctx
+}
+
+function input(over: Partial<Parameters<typeof renderSkillMarkdown>[0]> = {}) {
+  return {
+    name: 'my-skill',
+    description: 'A test skill',
+    modelInvocable: true,
+    userInvocable: true,
+    body: 'Instructions body.',
+    ...over,
+  }
+}
+
+function userSkillsRoot(home: string): string {
+  return join(home, '.dsh', 'skills')
+}
+
+function skillFilePath(home: string, name: string): string {
+  return join(userSkillsRoot(home), name, 'SKILL.md')
+}
